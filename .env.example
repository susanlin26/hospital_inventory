# Backend only. Put real values in Render, never in this file or Netlify browser assets.
INVENTORY_CLOUD=true
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PUBLIC_ORIGINS=https://staging--YOUR-SITE.netlify.app
NETLIFY_SITE_ID=YOUR-NETLIFY-SITE-ID
NETLIFY_PROXY_SECRET=GENERATE-AT-LEAST-32-RANDOM-CHARACTERS
BOOTSTRAP_TOKEN=GENERATE-A-DIFFERENT-RANDOM-SECRET
INVENTORY_ENVIRONMENT=雲端測試環境
